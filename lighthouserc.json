{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/codeguessr/browser",
      "url": [
        "http://localhost/index.html",
        "http://localhost/nl/index.html",
        "http://localhost/archive/index.html",
        "http://localhost/nl/archive/index.html",
        "http://localhost/privacy/index.html"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 800000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
